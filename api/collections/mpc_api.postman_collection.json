            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "return  pm.test('responde 200', () => pm.response.to.have.status(200))"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Auth Tokens",
      "item": [
        {
          "name": "Login Vet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{SUPABASE_URL}}/auth/v1/token?grant_type=password",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{VET_EMAIL}}\",\n  \"password\": \"{{VET_PASSWORD}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "pm.test('login vet ok', () => { if (d.access_token) pm.environment.set('VET_TOKEN', d.access_token); });",
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Admin",
          "request": {
